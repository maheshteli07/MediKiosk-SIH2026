# ============================================================
# MediKiosk – Root Environment Variables Example
# Copy this file to .env and fill in real values.
# ============================================================

# Application
APP_ENV=development
APP_NAME=MediKiosk

# Frontend
FRONTEND_URL=http://localhost:5173

# Backend
BACKEND_URL=http://localhost:8000

# MongoDB
MONGO_URI=mongodb://localhost:27017/medikiosk

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# AI / LLM
LLM_PROVIDER=mock
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o

# Speech
SPEECH_PROVIDER=mock
BHASHINI_API_KEY=your-bhashini-api-key-here

# OCR
OCR_PROVIDER=mock

# FHIR / ABDM / HIS
FHIR_BASE_URL=https://your-fhir-server.example.com
ABDM_BASE_URL=https://your-abdm-endpoint.example.com
HIS_BASE_URL=https://your-his-endpoint.example.com
