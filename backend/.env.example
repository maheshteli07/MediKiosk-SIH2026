# Application
APP_NAME=MediKiosk
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medikiosk

# Security - replace this fake value in your uncommitted local .env file.
JWT_SECRET=change-this-in-local-development
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS - comma-separated origins; include the Vite development server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI - true makes future AI integrations return canned/mock responses.
MOCK_AI_MODE=true

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png
