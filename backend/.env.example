# ============================================================
# MediKiosk Backend – Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# Application
APP_ENV=development
APP_NAME=MediKiosk
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medikiosk

# JWT  (use a long random string in production)
JWT_SECRET=change-this-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── AI Mode Toggle ──────────────────────────────────────────
# MOCK_AI_MODE=true  → all AI/OCR/Speech integrations return canned responses
# MOCK_AI_MODE=false → real API keys are used
# Set to true for demo/hackathon reliability. Set false in production.
MOCK_AI_MODE=true

# AI / LLM  (only needed when MOCK_AI_MODE=false)
LLM_PROVIDER=mock              # "mock" for canned responses, "gemini" for real AI
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Gemini (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# Speech  (only needed when MOCK_AI_MODE=false)
SPEECH_PROVIDER=mock
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# OCR  (only needed when MOCK_AI_MODE=false)
OCR_PROVIDER=mock

# FHIR / ABDM / HIS  (only needed for integration pushes)
FHIR_BASE_URL=https://your-fhir-server.example.com
ABDM_BASE_URL=https://your-abdm-endpoint.example.com
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret
HIS_BASE_URL=https://your-his-endpoint.example.com
HIS_API_KEY=your-his-api-key

# CORS – comma-separated list of allowed origins
# The Vite dev server (5173) must always be included.
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
