# Application
APP_NAME=MediKiosk
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medikiosk

# Security - replace this fake value in your uncommitted local .env file.
JWT_SECRET=change-this-in-local-development
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS - comma-separated origins; include the Vite development server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI - true makes future AI integrations return canned/mock responses.
MOCK_AI_MODE=true

# AI / LLM  (only needed when MOCK_AI_MODE=false)
LLM_PROVIDER=mock              # "mock" for canned responses, "gemini" for real AI
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Gemini (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# Speech  (only needed when MOCK_AI_MODE=false)
SPEECH_PROVIDER=mock
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# OCR  (only needed when MOCK_AI_MODE=false)
OCR_PROVIDER=mock

# FHIR / ABDM / HIS  (only needed for integration pushes)
FHIR_BASE_URL=https://your-fhir-server.example.com
ABDM_BASE_URL=https://your-abdm-endpoint.example.com
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret
HIS_BASE_URL=https://your-his-endpoint.example.com
HIS_API_KEY=your-his-api-key

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png
