# ============================================================
# MediKiosk Backend – Environment Variables Example
# Copy to .env and fill in values.
# ============================================================

# Application
APP_ENV=development
APP_NAME=MediKiosk
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medikiosk

# JWT
JWT_SECRET=your-very-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# AI / LLM
LLM_PROVIDER=mock
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Speech
SPEECH_PROVIDER=mock
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# OCR
OCR_PROVIDER=mock

# FHIR / ABDM / HIS
FHIR_BASE_URL=https://your-fhir-server.example.com
ABDM_BASE_URL=https://your-abdm-endpoint.example.com
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret
HIS_BASE_URL=https://your-his-endpoint.example.com
HIS_API_KEY=your-his-api-key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
